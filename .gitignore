# ==============================================================================
# PortPeek - Git Ignore Rules
# ==============================================================================

# --- Executables, Libraries & Binaries ---
*.exe
*.dll
*.so
*.dylib
*.msi
*.lib
*.exp

# --- Compilation & Debug Artifacts (MSVC / GCC / Clang) ---
*.pdb
*.obj
*.res
*.ilk
*.idb
*.iobj
*.ipdb
*.pch
*.tlog
*.lastbuildstate

# --- Visual Studio & IDE Configurations ---
.vs/
*.sln.docstates
*.user
*.suo
*.VC.db
*.VC.opendb
Debug/
Release/
x64/
x86/
ARM/
ARM64/

# --- JetBrains & VS Code ---
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# --- CMake Artifacts ---
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
CMakeUserPresets.json
build/
bin/
out/

# --- Local User Configurations & Environment ---
.portpeek
portpeek.json
*.local
.env
.env.*
!.env.example

# --- Python & Test Suites ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
test_runner.exe
*.venv/
venv/
env/

# --- Temporary & Diagnostic Files ---
*.tmp
*.temp
*.log
*.bak
*.swp
*~
*.bmp

# --- OS Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
