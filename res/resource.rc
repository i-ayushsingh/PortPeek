#include <windows.h>
#include "../src/resource.h"

// 1. Icons
// Primary application / system tray icon (icon-only mark)
IDI_APPICON   ICON "appicon.ico"
// Secondary full branded tile icon
IDI_TILEICON  ICON "icon.ico"

// 2. Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PortPeek"
            VALUE "FileDescription",  "PortPeek - Tiny Native Port Inspector"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PortPeek"
            VALUE "LegalCopyright",   "PortPeek"
            VALUE "OriginalFilename", "PortPeek.exe"
            VALUE "ProductName",      "PortPeek"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
